#!/usr/bin/env bash
#
# Shared utility functions: logging, command checks and git helpers.

# Colorize only when writing to a terminal and NO_COLOR is not set
# (https://no-color.org/).
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    UTILS_COLORS_ENABLED=true
else
    UTILS_COLORS_ENABLED=false
fi

# Not readonly on purpose: this file is sourced multiple times per shell.
UTILS_COLOR_RESET="\033[0m"
UTILS_COLOR_TIMESTAMP="\033[36m"
UTILS_COLOR_MESSAGE="\033[37m"
UTILS_COLOR_DEBUG="\033[37m"
UTILS_COLOR_INFO="\033[34m"
UTILS_COLOR_SUCCESS="\033[32m"
UTILS_COLOR_WARNING="\033[33m"
UTILS_COLOR_ERROR="\033[31m"

get_log_color() {
    case "$1" in
        DEBUG) printf "%b" "${UTILS_COLOR_DEBUG}" ;;
        INFO) printf "%b" "${UTILS_COLOR_INFO}" ;;
        SUCCESS) printf "%b" "${UTILS_COLOR_SUCCESS}" ;;
        WARNING) printf "%b" "${UTILS_COLOR_WARNING}" ;;
        ERROR) printf "%b" "${UTILS_COLOR_ERROR}" ;;
        *) printf "%b" "${UTILS_COLOR_RESET}" ;;
    esac
}

log() {
    local level="$1"
    shift

    if [ "${UTILS_COLORS_ENABLED}" != "true" ]; then
        printf "[%s] %-7s| %s\n" "$(date +'%H:%M:%S')" "${level}" "$*"
        return 0
    fi

    local color
    color="$(get_log_color "${level}")"
    printf "%b[%s]%b %-7s| %b%s%b\n" \
        "${UTILS_COLOR_TIMESTAMP}" "$(date +'%H:%M:%S')" "${color}" "${level}" \
        "${UTILS_COLOR_MESSAGE}" "$*" "${UTILS_COLOR_RESET}"
}

debug() {
    if [ "${NVIM_DEV:-false}" = "true" ]; then
        log "DEBUG" "$*"
    fi
}
info() { log "INFO" "$*"; }
success() { log "SUCCESS" "$*"; }
warning() { log "WARNING" "$*" >&2; }
error() { log "ERROR" "$*" >&2; }


check_command() {
    command -v "$1" >/dev/null 2>&1
}

is_repo() {
    if [ "$#" -ne 1 ]; then
        error "Function needs exactly one 'path' argument." && return 2
    fi

    local path=$1
    if [ ! -d "${path}" ]; then
        error "Path '${path}' does not exist or is not a directory." && return 1
    fi

    if ! git -C "${path}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        error "Path '${path}' is not a git repo." && return 1
    fi

    success "Path '${path}' is a git repo."
    return 0
}

pull_repo() {
    if [ "$#" -ne 1 ]; then
        error "Function needs exactly one 'path' argument." && return 2
    fi

    local path=$1
    if [ ! -d "${path}" ]; then
        error "Path '${path}' does not exist or is not a directory." && return 1
    fi

    git -C "${path}" checkout main 2>/dev/null \
        || git -C "${path}" checkout master 2>/dev/null \
        || true

    if ! git -C "${path}" pull; then
        error "Can not pull repo at '${path}'." && return 1
    fi

    success "Pulled repo at '${path}'." && return 0
}

clone_repo() {
    if [ "$#" -ne 2 ]; then
        error "Function needs exactly two arguments, 'repo-url' and 'dest-dir'." && return 2
    fi

    local repo_url=$1
    local dest_dir=$2
    local tmpfile
    tmpfile=$(mktemp)

    git clone --depth=1 "${repo_url}" "${dest_dir}" >"${tmpfile}" 2>&1 &
    echo "$! ${tmpfile}"
    return 0
}

wait_for_clone_process() {
    if [ "$#" -ne 2 ]; then
        error "Function needs exactly two arguments, 'pid' and 'tmpfile'." && return 2
    fi

    local pid=$1
    local tmpfile=$2

    info "Waiting for clone process ${pid} to finish."
    if ! tail --pid="${pid}" -f "${tmpfile}"; then
        error "Can not tail ${tmpfile}." && return 3
    fi

    if ! wait "${pid}"; then
        error "Can not wait ${pid}." && return 1
    fi

    rm -f "${tmpfile}"
    success "Clone process ${pid} finished." && return 0
}

kill_clone_process() {
    if [ "$#" -ne 1 ]; then
        error "Function needs exactly one 'pid' argument." && return 2
    fi

    local pid=$1
    if ! kill "${pid}"; then
        error "Can not kill nerd-fonts process '${pid}'." && return 1
    fi

    success "Killed process ${pid}." && return 0
}
