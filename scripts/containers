#!/usr/bin/env bash

set -euo pipefail

function help() {
	cat <<EOF
Usage:
  $(basename "$0") <command> <distro>

Commands:
  help                    Shows this help message
  unit-test <distro>      Build the unit test image and run the bats suite
  install-test <distro>   Build the install test image and run the install script

Distros:
  fedora, ubuntu
EOF
}

function require_distro() {
	if [[ "${1:-}" != "fedora" && "${1:-}" != "ubuntu" ]]; then
		echo "ERROR: distro must be 'fedora' or 'ubuntu'."
		help && exit 1
	fi
}

function dockerfile() {
	echo "env/Dockerfile.${1}"
}

function unit_test() {
	require_distro "${1:-}"

	docker build -f "$(dockerfile "$1")" \
		--target=local \
		-t "${1}-nvim:unit-test" .
	docker run --rm "${1}-nvim:unit-test"
}

function install_test() {
	require_distro "${1:-}"

	# On a detached head (ci checkouts) the entrypoint simply tests the
	# copied working tree instead of switching to a branch.
	local branch
	branch="$(git branch --show-current)"

	docker build -f "$(dockerfile "$1")" \
		--target=install-local \
		-t "${1}-nvim:install-test" .
	docker run --rm ${branch:+-e BRANCH_TO_TEST="${branch}"} "${1}-nvim:install-test"
}

if [[ $# -lt 1 || $# -gt 2 ]]; then
	echo "ERROR: one command and at most one distro argument needed."
	help && exit 1
elif [[ "$1" == "help" ]]; then
	help
elif [[ "$1" == "unit-test" ]]; then
	unit_test "${2:-}"
elif [[ "$1" == "install-test" ]]; then
	install_test "${2:-}"
else
	echo "ERROR: Unkown command."
	help && exit 1
fi
exit 0
